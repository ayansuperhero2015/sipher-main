{
  "rules": {
    "typing": {
      "$convo": {
        ".read": "auth != null && (!$convo.beginsWith('d_') || $convo.contains(auth.uid))",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!$convo.beginsWith('d_') || $convo.contains(auth.uid))",
          ".validate": "!newData.exists() || (newData.hasChildren(['name', 'at']) && newData.child('name').isString() && newData.child('name').val().length <= 64 && newData.child('at').val() === now)"
        }
      }
    },
    "activity": {
      "$serverId": {
        ".read": "auth != null",
        "$channelId": {
          ".write": "auth != null",
          ".validate": "!newData.exists() || (newData.child('by').val() === auth.uid && newData.child('at').val() === now)",
          "at": { ".validate": "newData.isNumber()" },
          "by": { ".validate": "newData.isString()" },
          "everyoneAt": { ".validate": "newData.isNumber()" },
          "everyoneBy": { ".validate": "newData.val() === auth.uid" },
          "$other": { ".validate": false }
        }
      }
    },
    "parties": {
      "$partyId": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
          ".validate": "newData.hasChildren(['host', 'game', 'createdAt']) && newData.child('host').val() === auth.uid",
          "host": { ".validate": "newData.isString()" },
          "game": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "floor": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "seed": { ".validate": "newData.isNumber()" },
          "run": { ".validate": "newData.isNumber()" },
          "mode": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "roster": { "$uid": { ".validate": "newData.isNumber()" } },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'at', 'state']) && newData.child('name').isString() && newData.child('name').val().length <= 64 && newData.child('at').val() === now)"
          }
        },
        "looks": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "$field": { ".validate": "newData.isString() && newData.val().length <= 16" }
          }
        },
        "events": {
          "$run": {
            ".write": "!newData.exists() && auth != null && root.child('parties').child($partyId).child('meta/host').val() === auth.uid",
            "$event": {
              ".write": "auth != null && !data.exists()",
              ".validate": "newData.hasChildren(['t', 'by', 'at']) && newData.child('by').val() === auth.uid && newData.child('at').val() === now && newData.child('t').isString() && newData.child('t').val().length <= 8"
            }
          }
        }
      }
    },
    "pings": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$key": {
          ".write": "auth != null",
          ".validate": "newData.hasChildren(['at', 'by', 'name', 'channel']) && newData.child('at').val() === now && newData.child('by').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 64 && newData.child('channel').isString() && newData.child('channel').val().length <= 32"
        }
      }
    }
  }
}
